# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =============================================================================
# SMS GATEWAY & DLT CONFIGURATION (Server-Side Only - Indian TRAI DLT Compliant)
# =============================================================================
# SMS_BASE_URL: Full HTTP/HTTPS endpoint of the SMS Gateway provider
# Example: https://api.smsgateway.com/api/send or https://sms.provider.com/api/mt/SendSMS
SMS_BASE_URL="https://api.smsgateway.com/api/send"

# SMS_USER: API username, account identifier, or auth ID
SMS_USER="your_sms_username"

# SMS_PASSWORD: API password, secret key, or token
SMS_PASSWORD="your_sms_password"

# SMS_SENDER_ID: Registered 6-character alphabetic DLT Header/Sender ID (e.g. TRUSET)
SMS_SENDER_ID="TRUSET"

# SMS_CHANNEL: Gateway delivery channel (e.g., Trans, OTP, Promotional)
SMS_CHANNEL="Trans"

# SMS_ROUTE: Gateway route identifier (e.g., 2, 4, OTP, Transactional)
SMS_ROUTE="OTP"

# SMS_PE_ID: 19-digit Principal Entity ID registered on Indian Telecom DLT portal
SMS_PE_ID="1001000000000000000"

# SMS_DLT_TEMPLATE: 19-digit Content Template ID registered on Indian Telecom DLT portal
SMS_DLT_TEMPLATE="1007000000000000000"
