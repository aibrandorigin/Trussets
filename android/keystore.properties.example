# Owner-Controlled Android Upload Keystore Configuration Template
# Copy this file to android/keystore.properties (which is gitignored) and fill in your credentials before running ./gradlew assembleRelease or ./gradlew bundleRelease
storeFile=trussets-upload-key.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=trussets-upload
keyPassword=YOUR_KEY_PASSWORD
