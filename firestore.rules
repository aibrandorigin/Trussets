rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /health/{docId} {
      allow read, write: if true;
    }
    match /properties/{propertyId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /admins/{adminId} {
      allow read, write: if true;
    }
    match /subscriptions/{subscriptionId} {
      allow read, write: if true;
    }
    match /settings/{settingId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
